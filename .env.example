# Copy to .env (never commit .env).

# SEC fair-access policy: identify yourself as "Name email". Requests without it get 403.
SEC_USER_AGENT="Your Name your.email@example.com"

# RustFS (raw landing). The host port is 9010; see docker-compose.yml.
S3_ENDPOINT_URL=http://localhost:9010
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=change-me
S3_BUCKET=raw
# How ClickHouse (inside docker) reaches RustFS.
S3_INTERNAL_ENDPOINT=http://rustfs:9000

# ClickHouse (analytical store)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=edgar
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=edgar
